# Используем образ с JDK 17 (Temurin) на Alpine
FROM eclipse-temurin:17-jdk-alpine

# Устанавливаем Python 3 и pip
RUN apk add --no-cache python3 py3-pip bash curl

WORKDIR /app

# Копируем весь проект
COPY PPO_f /app/PPO_f

# Устанавливаем Python-зависимости для E2E
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# Делаем gradlew исполняемым
RUN chmod +x /app/PPO_f/gradlew

# Собираем jar без запуска тестов
RUN cd /app/PPO_f && ./gradlew :app_cli:build -x test

# Переменные окружения для подключения к БД
# Эти переменные будут переопределены при запуске контейнера
ENV POSTGRES_HOST=localhost
ENV POSTGRES_PORT=5432
ENV POSTGRES_USER=testuser
ENV POSTGRES_PASSWORD=testpassword
ENV POSTGRES_DB=testdb

# По умолчанию запускаем jar (можно изменить на pytest для python тестов)
CMD ["java", "-jar", "/app/PPO_f/app_cli/build/libs/app_cli-1.0-SNAPSHOT.jar"]
