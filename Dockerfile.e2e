# Используем Python 3.11 slim
FROM python:3.11-slim

# Рабочая директория
WORKDIR /app

# Устанавливаем необходимые пакеты: OpenJDK 21 (для JAR), curl, psycopg2 для Python
RUN apt-get update && \
    apt-get install -y openjdk-21-jdk curl gcc libpq-dev && \
    pip install --no-cache-dir psycopg2-binary && \
    rm -rf /var/lib/apt/lists/*

# Копируем код проекта (тесты и jar)
COPY PPO_f /app/PPO_f

# По умолчанию запускаем Python тесты
CMD ["python3", "-m", "unittest", "discover", "-s", "PPO_f", "-p", "main.py"]

