FROM eclipse-temurin:21-jdk

WORKDIR /app

# Копируем код
COPY PPO_f /app/PPO_f

WORKDIR /app/PPO_f

# Устанавливаем права и исправляем переносы строк
RUN apt-get update && apt-get install -y dos2unix && \
    dos2unix ./gradlew && \
    chmod +x ./gradlew

ENV POSTGRES_HOST=postgres \
    POSTGRES_PORT=5432 \
    POSTGRES_USER=testuser \
    POSTGRES_PASSWORD=testpassword \
    POSTGRES_DB=testdb

ENTRYPOINT ["bash", "-c", "echo 'Running DB and BL tests...' && ./gradlew :app_cli:test --stacktrace --info"]
