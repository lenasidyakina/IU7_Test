# Используем JDK 17
FROM eclipse-temurin:17-jdk-alpine

WORKDIR /app

# Копируем Gradle и исходники
COPY settings.gradle.kts ./
COPY build.gradle.kts ./
COPY gradle ./gradle
COPY gradlew ./
COPY PPO_F ./PPO_F

RUN chmod +x ./gradlew

# Сборка без тестов
RUN ./gradlew build -x test

# По умолчанию запускаем тесты в app_cli
CMD ["./gradlew", ":app_cli:test"]
