FROM eclipse-temurin:17-jdk

WORKDIR /app

# Копируем проект
COPY PPO_f PPO_f

# Права на gradlew
RUN chmod +x PPO_f/gradlew

# Проверяем наличие файлов
RUN ls -l PPO_f
RUN cat PPO_f/settings.gradle

WORKDIR /app/PPO_f

# Собираем модули DB и BL
RUN ./gradlew :DB:build :BL:build --no-daemon --stacktrace --info

# Точка входа — запуск unit-тестов
ENTRYPOINT ["./gradlew", ":DB:test", ":BL:test", "--stacktrace", "--info"]
