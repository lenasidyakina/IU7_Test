FROM eclipse-temurin:17-jdk

WORKDIR /app

# Копируем весь проект PPO_f целиком
COPY PPO_f PPO_f

# Даем права на запуск gradlew
RUN chmod +x PPO_f/gradlew

# Проверяем наличие файлов
RUN ls -l PPO_f

# Ставим зависимости и билдим проект
WORKDIR /app/PPO_f
RUN ./gradlew :DB:assemble :BL:assemble --no-daemon

# Точка входа — запуск unit-тестов
ENTRYPOINT ["./gradlew", ":DB:test", ":BL:test", "--stacktrace", "--info"]
