FROM eclipse-temurin:21-jdk

WORKDIR /app

# Копируем весь проект PPO_f
COPY PPO_f PPO_f

# Даем права на запуск gradlew
RUN chmod +x PPO_f/gradlew

WORKDIR /app/PPO_f

# Только для DB и BL модулей
ENTRYPOINT ["bash", "-c", "./gradlew :DB:test :BL:test --stacktrace --info && ./gradlew :DB:allureReport :BL:allureReport"]

