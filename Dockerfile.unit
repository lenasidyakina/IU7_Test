FROM eclipse-temurin:21-jdk

WORKDIR /app

RUN apt-get update && apt-get install -y curl tar

# Скачиваем и устанавливаем Allure CLI (версия 2.27.0)
RUN curl -fSL -o /tmp/allure.tgz https://github.com/allure-framework/allure2/releases/download/2.27.0/allure-2.27.0.tgz \
    && tar -zxvf /tmp/allure.tgz -C /opt/ \
    && ln -s /opt/allure-2.27.0/bin/allure /usr/bin/allure \
    && rm /tmp/allure.tgz

# Копируем весь проект
COPY PPO_f PPO_f
RUN chmod +x PPO_f/gradlew

WORKDIR /app/PPO_f

# Запуск только DB и BL тестов и генерация Allure-отчёта
ENTRYPOINT ["bash", "-c", "\
  ./gradlew :DB:test :BL:test --stacktrace --info && \
  allure generate build/allure-results -o build/reports/allure-report/allureReports --clean \
"]
