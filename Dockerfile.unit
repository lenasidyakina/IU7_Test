FROM eclipse-temurin:21-jdk

WORKDIR /app

# Копируем весь проект PPO_f
COPY PPO_f PPO_f

# Даем права на запуск gradlew
RUN chmod +x PPO_f/gradlew

WORKDIR /app/PPO_f

# Запуск unit-тестов с Allure и генерацией HTML-отчета
ENTRYPOINT ["bash", "-c", "./gradlew :DB:test :BL:test --stacktrace --info && ./gradlew allureReport"]

