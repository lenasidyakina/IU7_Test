FROM eclipse-temurin:21-jdk

WORKDIR /app


RUN apt-get update && apt-get install -y wget unzip
RUN wget -q https://github.com/allure-framework/allure2/releases/download/2.27.2/allure-2.27.2.zip -O /tmp/allure.zip \
    && unzip /tmp/allure.zip -d /opt/ \
    && rm /tmp/allure.zip
ENV PATH="/opt/allure-2.27.2/bin:${PATH}"


# Копируем весь проект
COPY PPO_f PPO_f
RUN chmod +x PPO_f/gradlew

WORKDIR /app/PPO_f

# Запуск только DB и BL тестов и генерация Allure-отчёта
ENTRYPOINT ["bash", "-c", "\
  ./gradlew :DB:test :BL:test --stacktrace --info && \
  ./gradlew :DB:allureReport :BL:allureReport -D\"allure.results.directory=build/allure-results\" \
"]
